        "Problem 2: The Water Jug Problem (Solved using BFS)\n",
        "Problem Statement:\n",
        "You are given two jugs: Jug A with a capacity of 4 litres, and Jug B with a capacity of 3 litres. Neither jug has any markings on it. Using only the following operations — (i) fill a jug completely, (ii) empty a jug completely, (iii) pour water from one jug into the other until either the first jug is empty or the second jug is full — determine the minimum sequence of steps needed to measure out exactly 2 litres of water in any one jug.\n",
        "    "
      ],
      "metadata": {
        "id": "D0O_qGzg510q"
      }
    },
    {
      "cell_type": "markdown",
      "source": [],
      "metadata": {
        "id": "mn9hvNLF6C2h"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from collections import deque\n",
        "\n",
        "# Capacities of the jugs\n",
        "capacity_a = 4\n",
        "capacity_b = 3\n",
        "\n",
        "# Initial state\n",
        "start = (0, 0)\n",
        "\n",
        "# BFS queue\n",
        "queue = deque([(start, [])])\n",
        "\n",
        "# Visited states\n",
        "visited = set()\n",
        "visited.add(start)\n",
        "\n",
        "while queue:\n",
        "    (a, b), path = queue.popleft()\n",
        "\n",
        "    # Check if we have exactly 2 litres\n",
        "    if a == 2 or b == 2:\n",
        "        print(\"Minimum number of steps:\", len(path))\n",
        "        print(\"\\nSequence of steps:\")\n",
        "\n",
        "        for i, step in enumerate(path, 1):\n",
        "            print(i, \".\", step)\n",
        "\n",
        "        print(\"\\nFinal state:\", (a, b))\n",
        "        break\n",
        "\n",
        "    # Generate possible next states\n",
        "\n",
        "    next_states = []\n",
        "\n",
        "    # 1. Fill Jug A completely\n",
        "    next_states.append(((capacity_a, b), \"Fill Jug A\"))\n",
        "\n",
        "    # 2. Fill Jug B completely\n",
        "    next_states.append(((a, capacity_b), \"Fill Jug B\"))\n",
        "\n",
        "    # 3. Empty Jug A\n",
        "    next_states.append(((0, b), \"Empty Jug A\"))\n",
        "\n",
        "    # 4. Empty Jug B\n",
        "    next_states.append(((a, 0), \"Empty Jug B\"))\n",
        "\n",
        "    # 5. Pour Jug A into Jug B\n",
        "    amount = min(a, capacity_b - b)\n",
        "    next_states.append(((a - amount, b + amount),\n",
        "                        \"Pour Jug A into Jug B\"))\n",
        "\n",
        "    # 6. Pour Jug B into Jug A\n",
        "    amount = min(b, capacity_a - a)\n",
        "    next_states.append(((a + amount, b - amount),\n",
        "                        \"Pour Jug B into Jug A\"))\n",
        "\n",
        "    # Add new states to queue\n",
        "    for state, action in next_states:\n",
        "        if state not in visited:\n",
        "            visited.add(state)\n",
        "            queue.append((state, path + [action]))"
